---
filters:
  - filters/cv-layout.lua
format:
  html:
    toc: true
    toc-title: Sections
    page-layout: article
    css: styles/cv.css
    embed-resources: true
    link-external-newwindow: true
  pdf:
    pdf-engine: xelatex
    documentclass: article
    fontsize: 10pt
    geometry:
      - top=1.55cm
      - bottom=1.55cm
      - left=1.65cm
      - right=1.65cm
    include-in-header: styles/cv-pdf.tex
    colorlinks: true
    linkcolor: cvblue
    urlcolor: cvblue
    citecolor: cvblue
params:
  lang: en
  version: full
  sections: ""
  publication_summary: true
  data_file: data/cv.xlsx
execute:
  echo: false
  warning: false
  message: false
  freeze: false
---

```{r}
#| label: setup
#| include: false

source("R/read_cv.R")
source("R/helpers.R")
source("R/publications.R")
source("R/network.R")
source("R/sections.R")

cv <- read_cv_workbook(params$data_file)
cv$render_options <- list(
  publication_summary = isTRUE(as_cv_logical(params$publication_summary)[1])
)
lang <- normalize_language(params$lang)
selected_sections <- resolve_sections(cv, params$version, params$sections)
validate_cv_data(cv, lang, selected_sections)
```

```{r}
#| label: render-cv
#| results: asis

render_cv_sections(cv, lang, selected_sections)
```
