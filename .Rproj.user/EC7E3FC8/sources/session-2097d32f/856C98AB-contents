args <- commandArgs(trailingOnly = TRUE)

publication_summary_arg <- args[grepl(
  "^--publication[-_]summary=|^publication_summary=",
  args,
  ignore.case = TRUE
)]
positional <- args[!grepl(
  "^--publication[-_]summary=|^publication_summary=",
  args,
  ignore.case = TRUE
)]

lang <- if (length(positional) >= 1) positional[[1]] else "en"
version <- if (length(positional) >= 2) positional[[2]] else "full"
formats <- if (length(positional) >= 3) {
  strsplit(positional[[3]], ",", fixed = TRUE)[[1]]
} else {
  c("html", "pdf")
}
sections <- if (length(positional) >= 4) positional[[4]] else ""

normalize_boolean_parameter <- function(x, default = "true") {
  if (!length(x)) return(default)
  value <- sub("^[^=]+=", "", x[[length(x)]])
  value <- tolower(trimws(value))
  if (value %in% c("true", "t", "1", "yes", "y", "si", "sì")) return("true")
  if (value %in% c("false", "f", "0", "no", "n")) return("false")
  stop("publication_summary must be yes/no or true/false.")
}

publication_summary <- normalize_boolean_parameter(publication_summary_arg, "true")

quarto <- Sys.which("quarto")
if (!nzchar(quarto)) stop("Quarto was not found on PATH. Install Quarto before rendering.")
if (!dir.exists("docs")) dir.create("docs", recursive = TRUE)

for (format in formats) {
  format <- trimws(format)
  extension <- if (format == "html") "html" else if (format == "pdf") "pdf" else format
  output_name <- sprintf("cv-%s-%s.%s", lang, version, extension)
  command <- c(
    "render", "cv.qmd", "--to", format,
    "--output-dir", "docs", "--output", output_name,
    "-P", paste0("lang:", lang),
    "-P", paste0("version:", version),
    "-P", paste0("publication_summary:", publication_summary)
  )
  if (nzchar(sections)) command <- c(command, "-P", paste0("sections:", sections))
  status <- system2(quarto, command)
  if (!identical(status, 0L)) stop("Quarto rendering failed for format: ", format)
  message("Created docs/", output_name)
}
